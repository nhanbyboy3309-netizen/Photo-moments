GENERATE_SOURCEMAP=false

# Supabase (used only by server.js, for the /api/confirm-payment endpoints)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-anon-key

# Gate key sent to id-photo-booth-pro so it can verify a service request came
# from this app (must match VITE_SERVICE_ENTRY_API_KEY there). This is a
# random secret string, NOT a Google/Gemini API key — never reuse a real
# Google API key here, or Google will auto-revoke it once it finds the key
# exposed in this public client bundle.
REACT_APP_SERVICE_ENTRY_API_KEY=your-random-gate-secret
