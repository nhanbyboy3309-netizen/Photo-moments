GENERATE_SOURCEMAP=false

# Supabase (used only by server.js, for the /api/confirm-payment endpoints)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-anon-key

# Note: the gate key sent to id-photo-booth-pro (must match SERVICE_ENTRY_API_KEY
# there) is hardcoded directly in src/pages/Cart.tsx, not read from env — AI
# Studio's Secrets aren't injected into the CRA build step, so a REACT_APP_*
# env var here would just bake in as an empty string on deploy.
